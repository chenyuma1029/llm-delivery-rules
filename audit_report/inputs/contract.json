  "topology": "collaboration excludes queries; end-to-end multicast one query; unicast per dispatched solver",
  "packet_order": "ordered query dispatch, answer-prefix admission, then downstream transaction",
  "atomicity": "CL-RAT evidence + judge choice + committed output is one downstream transaction",
  "reserve": "provisional prefix-output capacity; equality fits; charged as traffic only on commit; exact frozen downstream profile",
  "nonfit": "stop at first nonfitting ordered packet; strict empty; partial resolves admitted prefix if commit fits",
  "delivery": "strict/partial use same attempted path; direct1_fallback is a separate profile-known preflight branch",
  "denominator": "all 700 planned tasks retained, including empty outputs; missing correctness is never zero-imputed",
  "uncertainty": "same-data grid descriptive; 156 contexts are not independent samples; original primary uses 10000 task-paired stratified bootstrap",
  "provenance": "Frozen original scores plus authenticated deterministic policy cache; see source release hash manifest. No new predictions or correctness labels.",
